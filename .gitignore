# ==========================================
# 1. Backend (Java, Maven, Spring Boot)
# ==========================================
# Compiled class files
*.class

# Log files
*.log

# Compiled output directories
target/
backend/**/target/
!backend/**/src/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 2. Frontend (Node.js, Vite, npm)
# ==========================================
# Dependencies
node_modules/
frontend/node_modules/
jspm_packages/

# Production build output
dist/
dist-ssr/
frontend/dist/

# npm/Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Never commit secrets to Git!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

